PR-1014: Auszahlung von Festgeld auf das Girokonto

Bei Fälligkeit sollen Partner die Auszahlung per API anstoßen können.

--- a/payments/api.py
+++ b/payments/api.py
@@ -14,6 +14,7 @@
 MAX_BODY_BYTES = 64 * 1024
 _TRANSFER_PATH = re.compile(r"^/transfers/(\d+)$")
 _BALANCE_PATH = re.compile(r"^/accounts/([A-Za-z0-9]+)/balance$")
+_PAYOUT_PATH = re.compile(r"^/accounts/([A-Za-z0-9]+)/payout$")
 
 
 class ApiHandler(BaseHTTPRequestHandler):
@@ -71,6 +72,16 @@
         self._send_json(404, {"error": "not found"})
 
     def do_POST(self) -> None:
+        match = _PAYOUT_PATH.match(self.path)
+        if match:
+            payload = self._read_json()
+            service = self._service()
+            try:
+                service.payout(match.group(1), payload["target_iban"], int(payload["amount_cents"]))
+            finally:
+                service.close()
+            self._send_json(200, {"status": "ok"})
+            return
         if self.path != "/transfers":
             self._send_json(404, {"error": "not found"})
             return
